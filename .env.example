# =============================================================================
# Battles Record - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then start with:
#   docker-compose up -d

# =============================================================================
# Required Settings
# =============================================================================

# JWT secret for signing authentication tokens
# Generate a random string: openssl rand -hex 32
BR_JWT_SECRET=change-me-to-a-random-string

# Admin account credentials
BR_ADMIN_USERNAME=admin
BR_ADMIN_PASSWORD=change-me-to-a-secure-password

# =============================================================================
# Daemon Settings (optional)
# =============================================================================

# Port to expose (default: 8080)
# BR_PORT=8080

# Log level: trace, debug, info, warn, error (default: info)
# BR_LOG_LEVEL=info

# =============================================================================
# Storage Settings (optional)
# =============================================================================

# Directory for raw .ts segments during recording (default: /data/recordings)
# BR_RECORDINGS_DIR=/data/recordings

# Directory for processed files and Jellyfin library (default: /data/library)
# BR_LIBRARY_DIR=/data/library

# Directory for channel profile/banner images (default: /data/images)
# BR_IMAGES_DIR=/data/images

# Disk warning threshold percentage (default: 90)
# BR_DISK_WARNING_THRESHOLD=90

# Channels config file - channels are stored separately from the main config
# so they persist across container restarts (default: /config/channels.toml)
# BR_CHANNELS_FILE=/config/channels.toml

# =============================================================================
# Jellyfin Integration (optional)
# =============================================================================
# When enabled, processed recordings are exported to a Jellyfin-compatible
# library structure with NFO metadata files and images.
#
# Library structure:
#   {library_dir}/{platform}/{channel}/Season XX/
#     - {channel} - S01E001 - {title}.mp4
#     - {channel} - S01E001 - {title}.nfo
#     - tvshow.nfo, poster.jpg, logo.png, etc.
#
# Seasons are numbered by month (S01 = January, S02 = February, etc.)

# Enable Jellyfin library export (default: false)
# BR_JELLYFIN_ENABLED=false

# Download channel profile images for poster/logo/banner (default: true)
# BR_JELLYFIN_FETCH_IMAGES=true

# Download/extract episode thumbnails (default: true)
# BR_JELLYFIN_GENERATE_THUMBNAILS=true

# =============================================================================
# Post-Processing Settings (optional)
# =============================================================================

# Enable automatic post-processing (default: true)
# BR_PP_ENABLED=true

# Output format: mp4_reencode, mp4_copy, ts_concat (default: mp4_reencode)
# BR_PP_OUTPUT_FORMAT=mp4_reencode

# Segment handling: delete, concatenate, keep (default: delete)
# BR_PP_SEGMENT_HANDLING=delete

# Max concurrent FFmpeg jobs (default: 2)
# BR_PP_MAX_CONCURRENT=2

# Encoding settings (for mp4_reencode)
# BR_PP_CRF=20
# BR_PP_PRESET=medium
# BR_PP_VIDEO_CODEC=libx264
# BR_PP_AUDIO_CODEC=aac
# BR_PP_AUDIO_BITRATE=128k

# =============================================================================
# Platform Authentication (optional)
# =============================================================================
# Add tokens to enable recording from each platform.
# Tokens can be obtained through OAuth flows or platform developer consoles.

# Twitch
# BR_TWITCH_ACCESS_TOKEN=
# BR_TWITCH_REFRESH_TOKEN=
# BR_TWITCH_USERNAME=

# YouTube
# BR_YOUTUBE_ACCESS_TOKEN=
# BR_YOUTUBE_REFRESH_TOKEN=
# BR_YOUTUBE_USERNAME=

# Kick
# BR_KICK_ACCESS_TOKEN=
# BR_KICK_REFRESH_TOKEN=
# BR_KICK_USERNAME=

# =============================================================================
# OAuth Configuration (optional - enables "Connect with Platform" buttons)
# =============================================================================
# OAuth allows users to authenticate with platforms through the UI instead
# of manually providing tokens. Register OAuth apps at:
#   - Twitch: https://dev.twitch.tv/console/apps
#   - YouTube/Google: https://console.cloud.google.com/apis/credentials
#
# For Tauri desktop app, use redirect URI: battles-record://oauth/callback
# For web/Docker, use redirect URI: http://localhost:8080/api/oauth/callback

# Twitch OAuth
# BR_OAUTH_TWITCH_CLIENT_ID=
# BR_OAUTH_TWITCH_CLIENT_SECRET=
# BR_OAUTH_TWITCH_REDIRECT_URI=

# YouTube/Google OAuth
# BR_OAUTH_YOUTUBE_CLIENT_ID=
# BR_OAUTH_YOUTUBE_CLIENT_SECRET=
# BR_OAUTH_YOUTUBE_REDIRECT_URI=

# Kick OAuth (if/when available)
# BR_OAUTH_KICK_CLIENT_ID=
# BR_OAUTH_KICK_CLIENT_SECRET=
# BR_OAUTH_KICK_REDIRECT_URI=

# =============================================================================
# Notifications (optional)
# =============================================================================

# Discord webhook notifications
# BR_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# BR_DISCORD_ON_START=true
# BR_DISCORD_ON_END=true
# BR_DISCORD_ON_ERROR=false

# Telegram bot notifications
# BR_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# BR_TELEGRAM_CHAT_ID=-1001234567890
# BR_TELEGRAM_ON_START=true
# BR_TELEGRAM_ON_END=true
# BR_TELEGRAM_ON_ERROR=false

# Generic webhook notifications
# BR_WEBHOOK_URL=https://your-endpoint.com/notify
# BR_WEBHOOK_ON_START=true
# BR_WEBHOOK_ON_END=true
# BR_WEBHOOK_ON_ERROR=false
