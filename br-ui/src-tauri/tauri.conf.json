{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Battles Record",
  "version": "1.4.0",
  "identifier": "com.battles.record",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Battles Record",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#141418",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* http://* https://* ws://* wss://*",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/br-daemon"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["battles-record"]
      }
    }
  }
}
