		"build": "vite build",
		"build:sidecar": "node scripts/build-sidecar.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"tauri:dev": "node scripts/dev.js",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.6",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.7",
		"@typescript-eslint/eslint-plugin": "^8.74.0",
		"@typescript-eslint/parser": "^8.74.0",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@fabianlars/tauri-plugin-oauth": "^2.1.0",
		"@fontsource-variable/geist": "^5.2.8",
