		"@tauri-apps/plugin-shell": "^2.6.0",
		"@tauri-apps/plugin-window-state": "^2.5.0",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"eruda": "^3.4.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"vaul-svelte": "^0.3.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
